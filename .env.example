# ============================================================
# Aikiu — Variables de entorno (secretos)
# ============================================================
# Los chat_id NO se ponen acá: el adulto queda registrado
# automáticamente la primera vez que abre el bot y manda /start
# (queda guardado en state.json, ignorado por git).
# Los familiares se registran igual, mandando /start al bot familiar.
# ============================================================

# --- Obligatorios ---
BOT_TOKEN=PEGA_TU_TELEGRAM_BOT_TOKEN_AQUI
GROQ_API_KEY=PEGA_TU_GROQ_API_KEY_AQUI

# --- Opcional: bot familiar para alertas y puente /mensaje ---
# Creá un SEGUNDO bot con @BotFather y pegá su token acá.
FAMILIAR_BOT_TOKEN=PEGA_TU_FAMILIAR_BOT_TOKEN_AQUI

# --- Opcional: bot admin para monitoreo (vos + equipo, hasta 5) ---
# Creá un TERCER bot con @BotFather y pegá su token acá.
# Apenas esté arriba, cada integrante del equipo manda /start desde su Telegram
# y queda registrado como admin hasta llenar el cupo (5 por default). Se persiste
# en admin/admin_state.json. Ver detalles en admin/COMO_USAR.md.
ADMIN_BOT_TOKEN=PEGA_TU_ADMIN_BOT_TOKEN_AQUI

# --- Opcional: fijar los chat_ids de los admins desde .env ---
# Si seteás ADMIN_CHAT_IDS (coma-separada), esa lista MANDA y deshabilita el
# TOFU del bot: solo esos chats pueden usar /start, y /quitar_admin queda
# bloqueado (la lista la maneja el .env). Útil si vas a publicar el bot o si
# preferís control total. Si no la seteás, los primeros 5 /start ganan.
# ADMIN_CHAT_IDS=111111,222222,333333

# --- Opcional: tamaño del cupo de admins ---
# Default 5. Bajalo si tu equipo es más chico (más seguro: cierra antes la
# ventana de bootstrap), subilo si son más.
# ADMIN_MAX_USERS=5

# --- Opcional: override manual del TPD para los avisos de /llm ---
# Si lo dejás sin setear (default), el admin usa los límites del free tier
# de Groq por modelo desde core/llm_limits.py (detecta automáticamente
# qué modelos están en uso y aplica los topes de cada uno). Setealo solo
# si tenés tier pago de Groq y querés que los avisos usen tu cuota real.
# Tabla canónica: https://console.groq.com/docs/rate-limits
# GROQ_DAILY_TOKEN_LIMIT=500000

# --- Opcional: multi-tenant (preparado para correr varios adultos en el futuro) ---
# Si AIKIU_REGISTRY no está seteado, todo Aikiu vive en la raíz del repo
# (default = una sola instancia, como hasta ahora). Cuando quieras correr
# múltiples adultos en la misma máquina:
#   1. Seteá AIKIU_REGISTRY a un directorio padre, ej. /var/aikiu/instances
#   2. Por cada deploy seteá AIKIU_INSTANCE_ID distinto y movelo a su subdir
#   3. El admin bot va a descubrirlos solos.
# AIKIU_INSTANCE_ID=default
# AIKIU_REGISTRY=/var/aikiu/instances

# ============================================================
# Andromarta (humanoide sintético para testear Aikiu) — su .env va aparte
# ============================================================
# Andromarta tiene su propio archivo de variables: andromarta/.env
# Ver plantilla en andromarta/.env.example y la sección "Andromarta" en
# README.md. No se mezcla con este .env.
