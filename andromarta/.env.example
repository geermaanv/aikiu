# ============================================================
# Andromarta — humanoide sintético para testear Aikiu
# ============================================================
# Andromarta es totalmente autocontenida: tiene su propio .env, su propio
# código (en andromarta/) y su propio runtime (andromarta/data/), separado
# del .env raíz que usan aikiu.py / familiar_bot.py / admin_bot.py.
#
# Andromarta NO es un bot: es un cliente de USUARIO de Telegram que actúa
# como una adulta mayor sintética chateando con @aikiu_bot.
#
# Necesita una cuenta de Telegram con su número de teléfono. Lo ideal es
# que sea un número aparte (no tu personal ni el del adulto mayor real).
# Si no tenés otro número, podés usar el tuyo personal — ver la sección
# "Si vas a usar tu propio número" en andromarta/COMO_USAR.md para los
# recaudos que hay que tomar.
#
# Conseguí api_id y api_hash en https://my.telegram.org (no es el token de
# BotFather: es para clientes de usuario).
#
# IMPORTANTE: para no romper la instalación real, apuntá Andromarta a un
# bot Aikiu de PRUEBA, no al de tu adulto mayor (la primera vez que mande
# /start quedará registrada como "dueña" del bot apuntado, por TOFU).
# ============================================================

# Misma key de Groq que usa Aikiu — se duplica acá para que andromarta/
# sea independiente del .env raíz.
GROQ_API_KEY=PEGA_TU_GROQ_API_KEY_AQUI

ANDROMARTA_API_ID=
ANDROMARTA_API_HASH=
ANDROMARTA_PHONE=
ANDROMARTA_AIKIU_USERNAME=         # ej. aikiu_test_bot (sin @)

# Opcional: override del path del .session. Default: andromarta/data/andromarta.session
# ANDROMARTA_SESSION=andromarta/data/andromarta.session

ANDROMARTA_NOMBRE_CLARA=Clara
ANDROMARTA_MODELO=llama-3.3-70b-versatile
ANDROMARTA_VOZ_TTS=es-AR-ElenaNeural
ANDROMARTA_VOZ_PROB=0.4            # 0.0 = solo texto, 1.0 = solo voz
